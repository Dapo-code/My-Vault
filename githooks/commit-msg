#!/usr/bin/env bash
set -euo pipefail

msg_file="$1"
first_line="$(head -n 1 "$msg_file" | tr -d '\r')"
pattern='^(SKILL UPDATE|DOC UPDATE|FIX|CHORE): .+'

if [[ ! "$first_line" =~ $pattern ]]; then
  echo "Invalid commit message."
  echo "Required format: PREFIX: summary"
  echo "Allowed PREFIX values: SKILL UPDATE | DOC UPDATE | FIX | CHORE"
  echo "Example: DOC UPDATE: update composer notes"
  exit 1
fi
