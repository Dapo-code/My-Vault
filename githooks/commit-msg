#!/usr/bin/env bash
set -euo pipefail

msg_file="$1"
first_line="$(head -n 1 "$msg_file" | tr -d '\r')"
pattern='^(SKILL|DOC|FIX|CHORE|FEAT): .+'

if [[ ! "$first_line" =~ $pattern ]]; then
  echo "Invalid commit message."
  echo "Required format: PREFIX: summary"
  echo "Allowed PREFIX values: SKILL | DOC | FIX | CHORE | FEAT"
  echo "Example: DOC: update composer notes"
  exit 1
fi
